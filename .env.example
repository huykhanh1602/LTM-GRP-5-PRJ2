# Sao chép thành ".env" để giao diện kết nối server thật.
VITE_WS_URL=ws://localhost:3000
# Để trống trong lúc phát triển để Vite proxy /api tới Node server.
# Trên Vercel phải đặt biến này bằng origin backend (Railway), ví dụ:
# VITE_API_URL=https://<railway-domain>  (không có dấu / ở cuối)
VITE_API_URL=
# Đặt true nếu chỉ muốn chạy giao diện với replay giả.
VITE_USE_MOCK=false
