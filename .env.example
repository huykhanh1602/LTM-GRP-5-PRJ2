# Sao chép thành ".env" để giao diện kết nối server thật.
VITE_WS_URL=ws://localhost:3000
# Để trống trong lúc phát triển để Vite proxy /api tới Node server.
# Trên Vercel phải đặt biến này bằng origin backend (Railway), ví dụ:
# VITE_API_URL=https://<railway-domain>  (không có dấu / ở cuối)
VITE_API_URL=
# OAuth client IDs public: set same provider app IDs configured on the backend.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
# Đặt true nếu chỉ muốn chạy giao diện với replay giả.
VITE_USE_MOCK=false

# --- Biến môi trường của SERVER (đặt trên Railway, không phải Vercel) ---
# GOOGLE_CLIENT_ID=<Client ID web của Google Cloud>   bật Google login/link; client web cũng phải dùng ID này
# FACEBOOK_APP_ID=<Facebook App ID>                   bật Facebook login/link
# FACEBOOK_APP_SECRET=<Facebook App Secret>           chỉ đặt ở backend, không đưa lên frontend
# AUTH_ALLOW_GUEST=1        đặt 0 để tắt đăng nhập khách (mặc định bật, khách chỉ chơi casual)
# ALLOW_GUEST_RANKED=0      đặt 1 chỉ khi thử nghiệm: cho khách chơi ranked
# Để trống DATABASE_URL thì local dùng SQLite tại data/game.sqlite.
# Trên môi trường đã cấp PostgreSQL, đặt DATABASE_URL và chạy migration nếu cần.
DATABASE_URL=

# Vị trí SQLite trước/sau khi chuyển dữ liệu sang PostgreSQL.
DB_PATH=data/game.sqlite

# Cổng game server.
PORT=3000

# Đường dẫn interpreter Python cho game engine (Windows: py, Linux/Docker: python3)
PYTHON_EXECUTABLE=py
