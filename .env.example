# Sao chép thành ".env" để giao diện kết nối server thật.
VITE_WS_URL=ws://localhost:3000
# Để trống trong lúc phát triển để Vite proxy /api tới Node server.
# Trên Vercel phải đặt biến này bằng origin backend (Railway), ví dụ:
# VITE_API_URL=https://<railway-domain>  (không có dấu / ở cuối)
VITE_API_URL=
# Đặt true nếu chỉ muốn chạy giao diện với replay giả.
VITE_USE_MOCK=false

# --- Biến môi trường của SERVER (đặt trên Railway, không phải Vercel) ---
# GOOGLE_CLIENT_ID=<Client ID web của Google Cloud>   bật đăng nhập Google (POST /api/auth/google)
# AUTH_ALLOW_GUEST=1        đặt 0 để tắt đăng nhập khách (mặc định bật, khách chỉ chơi casual)
# ALLOW_GUEST_RANKED=0      đặt 1 chỉ khi thử nghiệm: cho khách chơi ranked
